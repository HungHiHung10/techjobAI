# Backend production env.
# Put real values in Render/Railway/Fly dashboard, not in Git.

PUBLIC_APP_URL=https://techjob-ai.vercel.app
OPENROUTER_HTTP_REFERER=https://techjob-ai.vercel.app
OPENROUTER_APP_TITLE=TechJob AI
CORS_ORIGINS=https://techjob-ai.vercel.app

# Database. Prefer Neon/Supabase/Railway Postgres with SSL enabled.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
PGSSLMODE=require

# LLM fallback order.
LLM_PROVIDER_CHAIN=openrouter,mistral,cerebras,groq

OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
