FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.backend.txt /app/requirements.backend.txt

# Install CPU torch first so sentence-transformers does not pull a larger wheel.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r /app/requirements.backend.txt

COPY be /app/be
COPY ai /app/ai
COPY skills /app/skills

EXPOSE 8000

CMD ["sh", "-c", "uvicorn be.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
